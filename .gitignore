# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files pouvant contenir des secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible secrets and retry files
*.retry
.vault_pass
vault-password*

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db